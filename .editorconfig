# =============================================================================
# ProVeMaps — .editorconfig
# Padroniza indentação, encoding e line-endings entre IDEs e editores.
# Mesma base do CRM Simples Internet, para os produtos ficarem alinhados.
# Documentação: https://editorconfig.org/
# =============================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Python — PEP 8 (4 espaços), linha de 100 (black/ruff/isort do projeto)
[*.{py,pyi,pyx}]
indent_size = 4
max_line_length = 100

# Frontend (JS/TS/Vue) e formatos de configuração — 2 espaços
[*.{js,jsx,ts,tsx,vue,mjs,cjs}]
indent_size = 2

[*.{json,jsonc,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.{html,htm,css,scss,sass,less}]
indent_size = 2

# Markdown — preserva quebras de linha (dois espaços no fim = quebra)
[*.md]
indent_size = 2
trim_trailing_whitespace = false

# Makefiles requerem TABs reais
[{Makefile,makefile,GNUmakefile,*.mk}]
indent_style = tab

# Shell scripts
[*.{sh,bash,zsh}]
indent_size = 2
end_of_line = lf

# Scripts Windows preservam CRLF (alinhado com .gitattributes)
[*.{bat,cmd,ps1,psm1}]
end_of_line = crlf

[*.sql]
indent_size = 2

[{Dockerfile,dockerfile,Dockerfile.*,*.dockerfile}]
indent_size = 2
