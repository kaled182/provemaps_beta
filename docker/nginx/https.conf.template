# https.conf.template — HTTPS com Let's Encrypt
# DOMAIN_PLACEHOLDER é substituído pelo entrypoint.sh via sed

# EV-0069: resolver o nome «web» em tempo de execução (DNS interno do Docker).
# Com «proxy_pass http://web:8000» o nginx resolvia só no arranque: quando o web
# era recriado com outro IP (deploy), ficava a mandar para o antigo → 502 em tudo
# até reiniciar o nginx. Com variável + resolver, volta a resolver a cada 10 s.
resolver 127.0.0.11 valid=10s ipv6=off;
resolver_timeout 5s;

# EV-0104: compressão. Esta config (conf.d/default.conf) é a que está viva; o gzip do
# nginx.prod.conf nunca era carregado e o /api/v1/monitoring/gpon/ ia com 2,3 MB por atualização.
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 1024;
gzip_types text/plain text/css text/xml text/javascript application/javascript
           application/json application/xml application/geo+json application/manifest+json
           image/svg+xml font/ttf font/otf;

client_max_body_size 100M;

# ── HTTP → HTTPS redirect ─────────────────────────────────────────────────────
server {
    listen 80;
    set $django_upstream http://web:8000;  # EV-0069: resolvido em runtime
    server_name DOMAIN_PLACEHOLDER;

    # Desafio ACME (renovação)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # EV-0047: o healthcheck do container bate aqui por HTTP em 127.0.0.1. Sem esta
    # rota era redirecionado para https://127.0.0.1 (certificado do domínio → falha)
    # e o nginx ficava sempre «unhealthy». Proxy ao /healthz real: o nginx só está
    # saudável se o Django responder. Só para o próprio container.
    location = /healthz {
        # de fora continua o redirect para HTTPS (não 403)
        error_page 403 = @to_https;
        allow 127.0.0.1;
        deny all;
        access_log off;
        proxy_pass $django_upstream/healthz;
        proxy_set_header Host localhost;
    }

    location @to_https {
        return 301 https://$host$request_uri;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS principal ───────────────────────────────────────────────────────────
server {
    listen 443 ssl http2;
    set $django_upstream http://web:8000;  # EV-0069: resolvido em runtime
    server_name DOMAIN_PLACEHOLDER;

    # Certificado Let's Encrypt
    ssl_certificate     /etc/letsencrypt/live/DOMAIN_PLACEHOLDER/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN_PLACEHOLDER/privkey.pem;

    # Protocolos e cifras (Mozilla Modern)
    ssl_protocols             TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache         shared:SSL:10m;
    ssl_session_timeout       10m;
    ssl_session_tickets       off;

    # Headers de segurança
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options           "SAMEORIGIN"                          always;
    add_header X-Content-Type-Options    "nosniff"                             always;
    add_header X-XSS-Protection          "1; mode=block"                       always;
    add_header Referrer-Policy           "no-referrer-when-downgrade"          always;

    # Desafio ACME (renovação)
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Arquivos estáticos com cache
    location /static/ {
        alias   /app/staticfiles/;
        expires 30d;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Proxy para Django (todas as demais rotas)
    location / {
        proxy_pass         $django_upstream;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto https;
        proxy_read_timeout 300s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;

        # WebSocket (Django Channels)
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
    }
}
